<view class="page">
  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-num purple">{{stats.total}}</text>
      <text class="stat-label">总解题数</text>
    </view>
    <view class="stat-card">
      <text class="stat-num red">{{stats.wrong}}</text>
      <text class="stat-label">错题数</text>
    </view>
    <view class="stat-card">
      <text class="stat-num green">{{stats.correct}}</text>
      <text class="stat-label">正确数</text>
    </view>
    <view class="stat-card">
      <text class="stat-num blue">{{stats.rate}}</text>
      <text class="stat-label">正确率</text>
    </view>
  </view>

  <!-- 筛选器 -->
  <view class="filter-bar">
    <view class="filter-tabs">
      <text class="filter-tab {{filterStatus==='all'?'active':''}}" bindtap="onFilterChange" data-status="all">全部</text>
      <text class="filter-tab {{filterStatus==='wrong'?'active':''}}" bindtap="onFilterChange" data-status="wrong">错题</text>
      <text class="filter-tab {{filterStatus==='correct'?'active':''}}" bindtap="onFilterChange" data-status="correct">正确</text>
    </view>
    <input class="search-input" placeholder="🔍 搜索题目..." bindinput="onKeywordInput" value="{{keyword}}"/>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{filtered.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无记录</text>
  </view>

  <!-- 记录列表 -->
  <view wx:else>
    <view
      class="record-card {{item.is_wrong ? 'wrong-card' : ''}} {{expandedId === item.id ? 'expanded' : ''}}"
      wx:for="{{filtered}}"
      wx:key="id"
      bindtap="toggleExpand"
      data-id="{{item.id}}"
    >
      <view class="record-header">
        <text class="record-icon">{{item.is_wrong ? '❌' : '✅'}}</text>
        <view class="record-main">
          <text class="record-q">{{item.question_text}}</text>
          <view class="record-meta">
            <text class="tag tag-red" wx:if="{{item.is_wrong}}">错题</text>
            <text class="tag tag-green" wx:else>已解答</text>
            <!-- <text class="tag tag-purple" wx:if="{{item.subject}}">{{item.subject}}</text> -->
            <text class="time-text">{{item.created_at.substring(0,10)}}</text>
          </view>
        </view>
      </view>

      <!-- 展开内容 -->
      <view class="record-detail" wx:if="{{expandedId === item.id}}">
        <text class="detail-label">AI 解析</text>
        <text class="detail-answer">{{item.llm_answer}}</text>
        <button
          class="mark-btn {{item.is_wrong ? 'mark-done' : ''}}"
          catchtap="onMarkWrong"
          data-id="{{item.id}}"
          disabled="{{item.is_wrong}}"
        >
          {{item.is_wrong ? '✅ 已在错题本' : '❌ 加入错题本'}}
        </button>
      </view>
    </view>
  </view>
</view>
