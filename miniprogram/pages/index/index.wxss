.input-card { margin: 20rpx 24rpx; }
.upload-area {
  border: 3rpx dashed #c4b5fd; border-radius: 16rpx;
  padding: 60rpx 20rpx; text-align: center; background: #faf5ff;
}
.upload-icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.upload-text { color: #6b7280; font-size: 28rpx; display: block; margin-bottom: 8rpx; }
.upload-hint { color: #a78bfa; font-size: 24rpx; display: block; }
.image-preview { position: relative; text-align: center; }
.preview-img { width: 100%; max-height: 400rpx; border-radius: 12rpx; }
.clear-btn {
  position: absolute; top: 12rpx; right: 12rpx;
  background: rgba(0,0,0,0.5); color: #fff;
  border-radius: 10rpx; padding: 8rpx 16rpx; font-size: 22rpx;
}
.divider {
  text-align: center; color: #9ca3af; font-size: 24rpx;
  margin: 24rpx 0; position: relative;
}
.divider::before, .divider::after {
  content: ''; position: absolute; top: 50%;
  width: 38%; height: 1px; background: #e5e7eb;
}
.divider::before { left: 0; } .divider::after { right: 0; }
.text-input {
  width: 100%; border: 2rpx solid #e5e7eb; border-radius: 12rpx;
  padding: 20rpx 24rpx; font-size: 28rpx; min-height: 120rpx;
  box-sizing: border-box; background: #f9fafb;
}
.btn-row { margin-top: 24rpx; }
.submit-btn { width: 100%; }

.result-card { margin: 0 24rpx 20rpx; }
.result-title { font-size: 32rpx; font-weight: 700; color: #374151; margin-bottom: 20rpx; }
.tags-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 20rpx; }
.section-label { font-size: 24rpx; color: #9ca3af; margin-bottom: 10rpx; margin-top: 20rpx; }
.question-box {
  background: #f8fafc; border-left: 6rpx solid #667eea;
  border-radius: 8rpx; padding: 20rpx 24rpx;
  font-size: 28rpx; line-height: 1.7; color: #374151;
}
.thinking-wrap { margin-top: 20rpx; border-radius: 12rpx; overflow: hidden; border: 1px solid #fde68a; }
.thinking-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 24rpx; background: #fefce8;
  font-size: 26rpx; color: #92400e;
}
.thinking-body {
  padding: 16rpx 24rpx; background: #fffbeb;
  font-size: 24rpx; color: #78350f; line-height: 1.7;
}
.answer-box {
  background: #f0fdf4; border: 2rpx solid #86efac; border-radius: 12rpx;
  padding: 24rpx; font-size: 28rpx; line-height: 1.8; color: #166534;
}
.action-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn-wrong {
  flex: 1; background: #fef2f2; color: #dc2626;
  border: 2rpx solid #fca5a5; border-radius: 12rpx;
  font-size: 26rpx; padding: 18rpx 0;
}
.btn-reset {
  flex: 1; background: transparent; color: #667eea;
  border: 2rpx solid #667eea; border-radius: 12rpx;
  font-size: 26rpx; padding: 18rpx 0;
}
.loading-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 999;
}
.loading-box {
  background: #fff; border-radius: 20rpx; padding: 50rpx 80rpx;
  display: flex; flex-direction: column; align-items: center; gap: 24rpx;
}
.spinner {
  width: 70rpx; height: 70rpx; border: 6rpx solid #e5e7eb;
  border-top-color: #667eea; border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 28rpx; color: #6b7280; }

.crop-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: #000; z-index: 100;
  display: flex; flex-direction: column;
}
.crop-header {
  padding: 100rpx 32rpx 20rpx;
  text-align: center;
}
.crop-title { color: #fff; font-size: 32rpx; font-weight: 600; display: block; }
.crop-hint  { color: rgba(255,255,255,0.6); font-size: 24rpx; display: block; margin-top: 8rpx; }
.canvas-wrap {
  flex: 1; overflow: hidden; position: relative;
  display: flex; align-items: center; justify-content: center;
}
.crop-canvas { display: block; }
.crop-actions {
  display: flex; gap: 20rpx; padding: 30rpx 32rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}
.crop-btn-skip {
  flex: 1; background: rgba(255,255,255,0.15); color: #fff;
  border-radius: 16rpx; font-size: 28rpx; padding: 24rpx 0; border: none;
}
.crop-btn-confirm {
  flex: 2; background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff; border-radius: 16rpx; font-size: 28rpx; padding: 24rpx 0; border: none;
}
.viz-row {
  display: flex; align-items: center; gap: 8rpx;
  margin-top: 16rpx; padding: 0 4rpx;
}
.viz-label { font-size: 26rpx; color: #6b7280; }

.tip-box {
  margin-top: 24rpx; padding: 16rpx 20rpx;
  background: #f0f4ff; border-radius: 12rpx;
  max-width: 480rpx;
}
.tip-label { font-size: 22rpx; color: #667eea; display: block; margin-bottom: 8rpx; font-weight: 600; }
.tip-text { font-size: 24rpx; color: #374151; line-height: 1.6; display: block; }

.viz-container {
  margin-top: 20rpx;
  border: 2rpx solid #c4b5fd;
  border-radius: 12rpx;
  overflow: hidden;
}
.viz-title {
  padding: 12rpx 20rpx;
  background: #f3e8ff;
  color: #7c3aed;
  font-size: 26rpx;
  font-weight: 600;
}
.viz-hint {
  font-size: 24rpx; color: #9ca3af;
  display: block; margin: 12rpx 0;
}
.viz-btn {
  width: 100%; background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff; border-radius: 12rpx; font-size: 28rpx;
  padding: 20rpx 0; border: none; margin-top: 8rpx;
}
.tts-row { margin-top: 16rpx; }
.tts-btn { width: 100%; background: #f3e8ff; color: #7c3aed;
  border: 2rpx solid #c4b5fd; border-radius: 12rpx;
  font-size: 28rpx; padding: 18rpx 0; }
