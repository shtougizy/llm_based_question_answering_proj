.page { min-height: 100vh; background: #f0f4f8; padding-bottom: 120rpx; }
.tabs { display: flex; background: #fff; padding: 8rpx; margin: 20rpx 24rpx; border-radius: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.07); }
.tab { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 12rpx; font-size: 24rpx; color: #6b7280; font-weight: 500; }
.tab.active { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; }

.error-bar { margin: 0 24rpx 16rpx; background: #fef2f2; border: 2rpx solid #fca5a5; border-radius: 12rpx; padding: 16rpx 20rpx; }
.error-text { font-size: 24rpx; color: #dc2626; }

.stats-row { display: flex; gap: 16rpx; padding: 0 24rpx 20rpx; }
.stat-card { flex: 1; background: #fff; border-radius: 16rpx; padding: 20rpx 10rpx; text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.07); }
.stat-num { font-size: 40rpx; font-weight: 700; display: block; }
.stat-label { font-size: 20rpx; color: #9ca3af; display: block; margin-top: 4rpx; }
.red { color: #dc2626; } .orange { color: #d97706; } .purple { color: #7c3aed; }

.action-bar { padding: 20rpx 24rpx; }
.btn-primary { width: 100%; background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; padding: 24rpx 0; border: none; }

.loading-wrap { text-align: center; padding: 80rpx; color: #9ca3af; }
.spinner { width: 60rpx; height: 60rpx; border: 5rpx solid #e5e7eb; border-top-color: #667eea; border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }

.empty-state { text-align: center; padding: 80rpx 40rpx; color: #9ca3af; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; display: block; }

.wrong-card { background: #fff; border-radius: 16rpx; margin: 12rpx 24rpx; padding: 24rpx; border-left: 6rpx solid #fca5a5; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.07); }
.expanded { border-color: #667eea; }
.wc-header { display: flex; align-items: flex-start; gap: 16rpx; }
.wc-icon { font-size: 36rpx; flex-shrink: 0; }
.wc-main { flex: 1; min-width: 0; }
.wc-q { font-size: 28rpx; color: #1f2937; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wc-meta { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; align-items: center; }
.time-text { font-size: 22rpx; color: #9ca3af; }
.wc-detail { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #fee2e2; }
.detail-label { font-size: 22rpx; color: #9ca3af; display: block; margin-bottom: 10rpx; }
.detail-answer { font-size: 26rpx; line-height: 1.7; color: #166534; background: #f0fdf4; border-radius: 10rpx; padding: 16rpx; display: block; }

.cluster-card { background: #fff; border-radius: 16rpx; margin: 12rpx 24rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.07); border-left: 6rpx solid #667eea; }
.sev-high { border-left-color: #dc2626; }
.sev-mid  { border-left-color: #f59e0b; }
.sev-low  { border-left-color: #10b981; }
.cluster-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.cluster-icon { font-size: 40rpx; }
.cluster-title { font-size: 28rpx; font-weight: 600; color: #1f2937; display: block; }
.cluster-sub { font-size: 22rpx; color: #6b7280; display: block; margin-top: 4rpx; }
.kn-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.kn-item { background: #f3e8ff; color: #7c3aed; border-radius: 10rpx; padding: 6rpx 16rpx; font-size: 24rpx; }

.practice-section { margin: 12rpx 24rpx; }
.practice-header { background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 12rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.07); }
.practice-title { font-size: 28rpx; font-weight: 700; color: #1f2937; display: block; }
.practice-sub { font-size: 22rpx; color: #6b7280; display: block; margin-top: 4rpx; }
.pq-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 12rpx; border: 2rpx solid #e5e7eb; }
.pq-card.shown { border-color: #86efac; background: #f0fdf4; }
.pq-num { font-size: 22rpx; color: #667eea; font-weight: 700; display: block; margin-bottom: 10rpx; }
.pq-content { font-size: 28rpx; color: #1f2937; line-height: 1.6; display: block; margin-bottom: 16rpx; }
.pq-answer { background: #f0fdf4; border-radius: 10rpx; padding: 16rpx; margin-bottom: 16rpx; }
.pq-ans-text { font-size: 26rpx; color: #059669; display: block; font-weight: 600; }
.pq-analyze { font-size: 24rpx; color: #166534; display: block; margin-top: 10rpx; line-height: 1.6; }
.pq-toggle { background: transparent; color: #059669; border: 2rpx solid #86efac; border-radius: 10rpx; font-size: 24rpx; padding: 10rpx 0; width: 100%; }

.report-box { margin: 0 24rpx; background: #f0fdf4; border: 2rpx solid #86efac; border-radius: 16rpx; padding: 24rpx; }
.report-text { font-size: 28rpx; line-height: 1.8; color: #166534; display: block; }
