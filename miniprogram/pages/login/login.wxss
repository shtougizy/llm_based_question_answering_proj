.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}
.logo-wrap {
  text-align: center;
  margin-bottom: 80rpx;
}
.logo-icon { font-size: 100rpx; display: block; margin-bottom: 20rpx; }
.logo-title { font-size: 52rpx; font-weight: 700; color: #fff; display: block; margin-bottom: 12rpx; }
.logo-sub { font-size: 28rpx; color: rgba(255,255,255,0.8); display: block; }
.login-card {
  width: 100%;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  background: #fff;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
}
.btn-wechat {
  width: 100%;
  background: #07c160;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 0;
  border: none;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.btn-icon { font-size: 36rpx; }
.btn-guest {
  width: 100%;
  background: #f3f4f6;
  color: #6b7280;
  border-radius: 16rpx;
  font-size: 28rpx;
  padding: 24rpx 0;
  border: none;
  margin-bottom: 24rpx;
}
.hint { font-size: 22rpx; color: #9ca3af; text-align: center; display: block; }
.loading-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex; align-items: center; justify-content: center;
}
.loading-box {
  background: #fff; border-radius: 16rpx; padding: 40rpx 60rpx;
  display: flex; flex-direction: column; align-items: center; gap: 20rpx;
}
.loading-spinner {
  width: 60rpx; height: 60rpx;
  border: 6rpx solid #e5e7eb;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
